@startuml
title Диаграмма классов

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam dpi 180
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 90
skinparam ranksep 90

hide circle
hide methods
hide stereotypes

skinparam class {
  BackgroundColor #D9D9D9
  BorderColor #4F9ED8
  HeaderBackgroundColor #4F9ED8
  HeaderFontColor white
  FontColor #1F6FA8
  FontSize 16
  AttributeFontSize 15
  BorderThickness 1.5
}

class "Риелтор" as Realtor {
  id
  --
  full_name
  email
  phone
  is_active
}

class "Сделка" as Deal {
  id
  --
  title
  description
  price
  status
  created_by
  created_at
  updated_at
}

class "Покупатель" as Buyer {
  id
  --
  full_name
  email
  phone
  passport_number
  inn
  is_active
  created_at
}

class "Продавец" as Seller {
  id
  --
  full_name
  email
  phone
  passport_number
  inn
  is_active
  created_at
}

class "Земля" as Land {
  id
  --
  cadastral_number
  address_area
  land_category
  description
  created_at
}

Realtor -[hidden]down- Deal
Buyer -[hidden]right- Deal
Deal -[hidden]right- Seller
Seller -[hidden]right- Land

Realtor "1" -[#4F9ED8,thickness=2]-> "0..*" Deal : сопровождает
Buyer "1" -[#4F9ED8,thickness=2]-> "0..*" Deal : покупатель
Seller "1" -[#4F9ED8,thickness=2]-> "0..*" Deal : продавец
Land "1" -[#4F9ED8,thickness=2]-> "0..*" Deal : объект сделки

@enduml
